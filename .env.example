# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Production environment variables for backend, storage, auth & payments
DATABASE_URL="postgresql://user:password@localhost:5432/govease_db"
AUTH_SECRET="your-jwt-auth-secret-key-32-chars-minimum"
PAYMENT_API_KEY="rzp_live_key_sample"
PAYMENT_SECRET="rzp_secret_sample"
STORAGE_BUCKET="govease-citizen-documents-secure"
EMAIL_API_KEY="sendgrid_or_resend_api_key"
SMS_API_KEY="fast2sms_or_twilio_key"
AI_API_KEY="gemini_or_custom_ai_key"
